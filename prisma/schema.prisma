// This is a placeholder Prisma schema
// It will be expanded with domain models in later phases

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Placeholder model - will be removed/replaced with actual domain models
model Placeholder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
