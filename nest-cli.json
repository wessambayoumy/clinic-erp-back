{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "./src",
  "compilerOptions": {
    "deleteOutDir": true,
    "typeCheck": true,
    "assets": [
      {
        "include": "prisma/contract.json",
        "outDir": "dist"
      }
    ],
    "watchAssets": true,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": ".swcrc"
      }
    }
  }
}
