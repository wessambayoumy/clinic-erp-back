# Copy this file to `.env.dev` and replace every placeholder before starting locally.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Replace both values with independent secrets from: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=90d

# Redis is required for OTP storage and BullMQ account-notification delivery.
REDIS_URL=redis://localhost:6379
BULLMQ_REDIS_URL=redis://localhost:6379

# Email delivery (file writes .eml files locally; production must use smtp)
MAIL_TRANSPORT=file
MAIL_FROM=verification@example.com
MAIL_FROM_NAME="Clinic ERP"
# Set this when MAIL_TRANSPORT=smtp, for example smtp://localhost:1025.
SMTP_URL=smtp://localhost:1025

# Replace with a unique secret from: openssl rand -hex 32
EMAIL_OTP_HASH_SECRET=replace-with-a-unique-64-character-random-secret
EMAIL_BCRYPT_ROUNDS=12
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_REQUEST_LIMIT_PER_HOUR=5

# Generate a base64-encoded 32-byte AES-256 key with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=replace-with-a-generated-base64-32-byte-key
# Generate a long random pepper with: openssl rand -hex 64
# Changing this later invalidates password hashes created with the previous value.
HASH_PEPPER=replace-with-a-unique-128-character-random-pepper
